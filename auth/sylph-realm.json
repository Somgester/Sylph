{
  "realm": "sylph",
  "enabled": true,
  "displayName": "Sylph",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "defaultSignatureAlgorithm": "EdDSA",
  "passwordPolicy": "length(8) and digits(1) and upperCase(1) and specialChars(1)",
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": "${SYLPH_GOOGLE_ENABLED:false}",
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${SYLPH_GOOGLE_CLIENT_ID_JSON}",
        "clientSecret": "${SYLPH_GOOGLE_CLIENT_SECRET_JSON}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "github",
      "displayName": "GitHub",
      "providerId": "github",
      "enabled": "${SYLPH_GITHUB_ENABLED:false}",
      "trustEmail": false,
      "storeToken": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${SYLPH_GITHUB_CLIENT_ID_JSON}",
        "clientSecret": "${SYLPH_GITHUB_CLIENT_SECRET_JSON}",
        "defaultScope": "user:email",
        "syncMode": "IMPORT"
      }
    }
  ],
  "clients": [
    {
      "clientId": "sylph-desktop",
      "name": "Sylph desktop",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": ["http://127.0.0.1:43117/oauth/callback"],
      "webOrigins": [],
      "attributes": {
        "id.token.signed.response.alg": "EdDSA",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:43117/oauth/logout"
      },
      "defaultClientScopes": ["profile", "email"]
    }
  ]
}
