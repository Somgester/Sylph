+
+#[cfg(unix)]
+fn sylph_probe_enabled() -> bool {
+    use std::os::unix::fs::PermissionsExt;
+    std::env::var_os("SYLPH_HERDR_CLICK_PROBE").as_deref() == Some(std::ffi::OsStr::new("1"))
+        && std::env::var_os("HERDR_APP_HOME").is_some_and(|home| {
+            let path = std::path::Path::new(&home);
+            path.is_absolute() && std::fs::symlink_metadata(path).is_ok_and(|meta| {
+                meta.is_dir() && meta.permissions().mode() & 0o077 == 0
+            })
+        })
+}
+
+#[cfg(not(unix))]
+fn sylph_probe_enabled() -> bool {
+    false
+}
+
+fn sylph_probe_click(value: &Value, window: &mut Window, cx: &mut App) -> Result<(), &'static str> {
+    let (Some(x), Some(y)) = (value.get(0).and_then(Value::as_f64), value.get(1).and_then(Value::as_f64)) else {
+        return Err("invalid click coordinates");
+    };
+    if !(0.0..1.0).contains(&x) || !(0.0..1.0).contains(&y) {
+        return Err("invalid click coordinates");
+    }
+    let viewport = window.viewport_size();
+    let position = point(viewport.width * x as f32, viewport.height * y as f32);
+    window.dispatch_event(PlatformInput::MouseDown(MouseDownEvent {
+        button: MouseButton::Left, position, click_count: 1, ..Default::default()
+    }), cx);
+    window.dispatch_event(PlatformInput::MouseUp(MouseUpEvent {
+        button: MouseButton::Left, position, click_count: 1, ..Default::default()
+    }), cx);
+    Ok(())
+}
