+#[cfg(unix)]
+fn sylph_probe_enabled() -> bool {
+    use std::os::unix::fs::PermissionsExt;
+    std::env::var_os("SYLPH_HERDR_CLICK_PROBE").as_deref() == Some(std::ffi::OsStr::new("1"))
+        && std::env::var_os("HERDR_APP_HOME").is_some_and(|home| {
+            let path = std::path::Path::new(&home);
+            path.is_absolute() && std::fs::symlink_metadata(path).is_ok_and(|meta| {
+                meta.is_dir() && meta.permissions().mode() & 0o077 == 0
+            })
+        })
+}
+
+#[cfg(not(unix))]
+fn sylph_probe_enabled() -> bool {
+    false
+}
+
+fn sylph_probe_click(value: &Value, window: &mut Window, cx: &mut App) -> Result<(), &'static str> {
+    let (Some(x), Some(y)) = (value.get(0).and_then(Value::as_f64), value.get(1).and_then(Value::as_f64)) else {
+        return Err("invalid click coordinates");
+    };
+    if !(0.0..1.0).contains(&x) || !(0.0..1.0).contains(&y) {
+        return Err("invalid click coordinates");
+    }
+    let viewport = window.viewport_size();
+    let position = point(viewport.width * x as f32, viewport.height * y as f32);
+    window.dispatch_event(PlatformInput::MouseDown(MouseDownEvent {
+        button: MouseButton::Left, position, click_count: 1, ..Default::default()
+    }), cx);
+    window.dispatch_event(PlatformInput::MouseUp(MouseUpEvent {
+        button: MouseButton::Left, position, click_count: 1, ..Default::default()
+    }), cx);
+    Ok(())
+}
+
+fn sylph_probe_keys(value: &Value, window: &mut Window, cx: &mut App) -> Result<(), &'static str> {
+    let keys = value.as_array().filter(|keys| (1..=128).contains(&keys.len()))
+        .ok_or("invalid key batch")?;
+    let mut strokes = Vec::with_capacity(keys.len());
+    for key in keys {
+        let token = key.as_str().ok_or("invalid key token")?;
+        let mut modifiers = Modifiers::default();
+        let (key, key_char) = if let Some(hex) = token.strip_prefix("u:") {
+            let ch = u32::from_str_radix(hex, 16).ok().and_then(char::from_u32)
+                .filter(|ch| !ch.is_control()).ok_or("invalid typed character")?;
+            let logical = if ch == ' ' {
+                "space".into()
+            } else {
+                modifiers.shift = ch.is_ascii_uppercase();
+                ch.to_ascii_lowercase().to_string()
+            };
+            (logical, Some(ch.to_string()))
+        } else {
+            match token {
+                "ctrl+c" => { modifiers.control = true; ("c".into(), None) }
+                "esc" => ("escape".into(), None),
+                "enter" | "backspace" | "tab" | "up" | "down" | "left" | "right" => {
+                    (token.into(), None)
+                }
+                _ => return Err("unsupported key"),
+            }
+        };
+        strokes.push(Keystroke { modifiers, key, key_char });
+    }
+    for stroke in strokes {
+        window.dispatch_keystroke(stroke, cx);
+    }
+    Ok(())
+}
